---
import '../styles/global.css';
import { base } from '../lib/base';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Time Pranksters de Pokémon VGC — notícias, liga semanal e torneios.',
} = Astro.props;

const pageTitle = title ? `${title} · Pranksters VGC` : 'Pranksters VGC';

const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/liga', label: 'Liga' },
  { href: '/torneios', label: 'Torneios' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-prank-bg text-white antialiased">
    <header class="border-b border-prank-border bg-prank-surface/80 backdrop-blur sticky top-0 z-40">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
        <a href={base} class="flex items-center gap-3 shrink-0">
          <img
            src={`${base}images/pranksters-logo.jpg`}
            alt="Logo Team Pranksters"
            width="40"
            height="40"
            class="h-10 w-10 rounded-full object-cover ring-1 ring-prank-gold/60"
          />
          <span class="font-display text-lg font-bold tracking-wide text-white">
            PRANKSTERS<span class="text-prank-gold"> VGC</span>
          </span>
        </a>

        <nav class="flex flex-wrap items-center gap-1 text-sm">
          {
            navLinks.map((link) => {
              const href = link.href === '/' ? base : `${base}${link.href.slice(1)}`;
              const isActive =
                link.href === '/' ? currentPath === base : currentPath.startsWith(href);
              return (
                <a
                  href={href}
                  class:list={[
                    'rounded-md px-3 py-2 font-medium transition-colors hover:bg-prank-surface-2 hover:text-prank-gold',
                    isActive ? 'text-prank-gold' : 'text-prank-purple-light',
                  ]}
                >
                  {link.label}
                </a>
              );
            })
          }
          <a
            href={`${base}admin`}
            class="ml-1 rounded-md border border-prank-border px-3 py-2 text-xs font-semibold uppercase tracking-wide text-white/60 hover:border-prank-gold hover:text-prank-gold"
          >
            Área do time
          </a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-10">
      <slot />
    </main>

    <footer class="mt-16 border-t border-prank-border bg-prank-surface/60">
      <div class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-4 py-8 text-center sm:flex-row sm:justify-between sm:text-left">
        <div class="text-sm text-white/50">
          <p class="font-display text-base text-white">Team Pranksters</p>
          <p>Pokémon VGC · Liga semanal e torneios</p>
          <a
            href="https://www.instagram.com/pranksters.vgc/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram do Team Pranksters"
            class="mt-2 inline-flex items-center gap-1.5 text-prank-purple-light transition-colors hover:text-prank-gold"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path
                d="M12 2.2c3.2 0 3.58.01 4.85.07 1.17.05 1.8.24 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.17.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.24 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.17-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.24-2.23-.41a3.73 3.73 0 0 1-1.38-.9 3.73 3.73 0 0 1-.9-1.38c-.17-.42-.36-1.06-.41-2.23C2.21 15.58 2.2 15.2 2.2 12s.01-3.58.07-4.85c.05-1.17.24-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.17 1.06-.36 2.23-.41C8.42 2.21 8.8 2.2 12 2.2zm0 1.8c-3.14 0-3.5.01-4.74.07-.96.04-1.48.2-1.82.33-.46.18-.79.39-1.13.74-.35.34-.56.67-.74 1.13-.13.34-.29.86-.33 1.82-.06 1.24-.07 1.6-.07 4.74s.01 3.5.07 4.74c.04.96.2 1.48.33 1.82.18.46.39.79.74 1.13.34.35.67.56 1.13.74.34.13.86.29 1.82.33 1.24.06 1.6.07 4.74.07s3.5-.01 4.74-.07c.96-.04 1.48-.2 1.82-.33.46-.18.79-.39 1.13-.74.35-.34.56-.67.74-1.13.13-.34.29-.86.33-1.82.06-1.24.07-1.6.07-4.74s-.01-3.5-.07-4.74c-.04-.96-.2-1.48-.33-1.82a3.05 3.05 0 0 0-.74-1.13 3.05 3.05 0 0 0-1.13-.74c-.34-.13-.86-.29-1.82-.33C15.5 4.01 15.14 4 12 4zm0 3.38a4.62 4.62 0 1 1 0 9.24 4.62 4.62 0 0 1 0-9.24zm0 1.8a2.82 2.82 0 1 0 0 5.64 2.82 2.82 0 0 0 0-5.64zm5.88-2a1.08 1.08 0 1 1-2.16 0 1.08 1.08 0 0 1 2.16 0z"
              ></path>
            </svg>
            <span>@pranksters.vgc</span>
          </a>
        </div>
        <a
          href="https://www.muitocolecionaveis.com.br/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 rounded-lg border border-prank-border bg-prank-surface-2 px-4 py-2 transition-colors hover:border-prank-gold"
        >
          <span class="text-xs uppercase tracking-wide text-white/50">Patrocinado por</span>
          <img
            src={`${base}images/muito-logo.jpg`}
            alt="Logo Muito!"
            width="72"
            height="72"
            loading="lazy"
            class="h-9 w-9 rounded object-cover"
          />
        </a>
      </div>
    </footer>
  </body>
</html>
